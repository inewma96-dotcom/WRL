# Authentication
# Required in production. Use a long, random value.
JWT_SECRET="replace-with-a-long-random-secret"

# Media (optional)
# These values only allow Next.js Image to load images from one configured
# remote host. Upload routes still save files locally under public/uploads.
MEDIA_CDN_URL="https://cdn.example.com"
# Legacy fallback for the same remote-image allowlist.
MEDIA_STORAGE_PUBLIC_URL=""
