DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Required in production. Use a long random value.
AUTH_SECRET="replace-with-a-long-random-secret"

# Local by default. Use "remote" for a cloud/proxy storage endpoint.
MEDIA_STORAGE_DRIVER="local"

# Required when MEDIA_STORAGE_DRIVER="remote".
MEDIA_STORAGE_UPLOAD_URL="https://storage.example.com/uploads"
MEDIA_STORAGE_TOKEN=""

# Public media base URL. Put your CDN URL here when using cloud storage.
MEDIA_STORAGE_PUBLIC_URL="https://cdn.example.com"
MEDIA_CDN_URL="https://cdn.example.com"

PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=PGK
PAYMENT_MERCHANT_NAME="Wantok Radio Light"
PAYMENT_SUPPORT_EMAIL=
PAYMENT_SUPPORT_PHONE=
PAYMENT_MINIMUM_AMOUNT_MINOR=100
PAYMENT_MAXIMUM_AMOUNT_MINOR=100000000
PAYMENT_REQUEST_TIMEOUT_MS=20000

MOCK_PAYMENT_SECRET=replace-with-a-long-random-secret
MOCK_PAYMENT_BASE_URL=http://localhost:3000

BSP_IPG_BASE_URL=
BSP_IPG_MERCHANT_ID=
BSP_IPG_TERMINAL_ID=
BSP_IPG_API_KEY=
BSP_IPG_API_SECRET=
BSP_IPG_CALLBACK_SECRET=
BSP_IPG_RETURN_URL=http://localhost:3000/payment/processing

KINA_IPG_BASE_URL=
KINA_IPG_MERCHANT_ID=
